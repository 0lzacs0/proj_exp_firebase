# Copie este arquivo para ".env" e preencha com os valores do seu projeto
# no Console do Firebase (Configurações do projeto > Seus apps > SDK setup).
#
# Em desenvolvimento local (localhost) a aplicação se conecta aos emuladores;
# para produção, preencha com os dados reais antes de rodar "npm run build".
VITE_FIREBASE_API_KEY=sua-api-key
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu-sender-id
VITE_FIREBASE_APP_ID=seu-app-id

# Opcional: defina como "false" para usar o projeto real mesmo em localhost.
# VITE_USE_EMULATORS=false
